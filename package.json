{
  "name": "astra-lan-rpg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "play": "npm run build && npm start",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "git:setup": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.25.0",
    "@colyseus/core": "^0.18.10",
    "@colyseus/schema": "^5.0.27",
    "@colyseus/sdk": "^0.18.2",
    "@colyseus/ws-transport": "^0.18.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "description": "RPG 3D cooperativo para navegador, PC y móvil, con servidor temporal en red local."
}
